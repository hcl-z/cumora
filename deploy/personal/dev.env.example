# Personal bot — local development on macOS.
# Copy to the repo root as `.env` (server/src/env.ts loads it via dotenv).
# `.env` is gitignored; never commit real keys.

# Required. Used for bot turns, triage and memory embeddings.
OPENAI_API_KEY=

# Single-user personal deployment: no demo seed, no starter team, no K8s pods.
PERSONAL_MODE=1

# Local services. These are the server's own defaults; uncomment to override.
# DATABASE_URL=postgres://<you>@localhost:5432/cumora
# REDIS_URL=redis://localhost:6379

# The Vite renderer runs on :5180. The server default (:5173) sends the browser
# to a dead port after sign-in, so pin it here. The local login link below is
# built from it too.
CUMORA_AUTH_DONE_URL=http://localhost:5180/

# Dev sign-in without an OAuth app: the server prints a one-time link at boot
# (single use, 10 minutes; restart the server for a new one). It refuses to
# start unless PERSONAL_MODE is on, NODE_ENV is not production and the API is
# bound to a literal loopback address.
PERSONAL_LOCAL_LOGIN=1
LISTEN_HOST=127.0.0.1

# Email stored on the account local login creates. Set it to the address you
# will later sign in with via OAuth so that identity joins this account; any
# other new account is refused in personal mode.
# PERSONAL_OWNER_EMAIL=you@example.com

# Shared secret the daemon uses to pair itself as this workspace's first
# computer, so you never copy a pairing code. At least 32 characters:
#   openssl rand -hex 32
# Give the daemon the same value as CUMORA_PERSONAL_BOOTSTRAP_TOKEN (see README).
# Leave empty to pair by hand instead.
PERSONAL_BOOTSTRAP_TOKEN=

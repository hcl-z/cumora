# Personal bot — local development on macOS.
# Copy to the repo root as `.env` (server/src/env.ts loads it via dotenv).
# `.env` is gitignored; never commit real keys.

# Required. Used for bot turns, triage and memory embeddings.
OPENAI_API_KEY=

# Single-user personal deployment: no demo seed, no starter team, no K8s pods.
PERSONAL_MODE=1

# Local services. These are the server's own defaults; uncomment to override.
# DATABASE_URL=postgres://<you>@localhost:5432/cumora
# REDIS_URL=redis://localhost:6379

# The Vite renderer runs on :5180. The server default (:5173) sends the browser
# to a dead port after sign-in, so pin it here.
CUMORA_AUTH_DONE_URL=http://localhost:5180/
